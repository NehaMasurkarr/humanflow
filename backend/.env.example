# Optional Uvicorn settings, read from the shell environment.
# export these values before starting uvicorn; this file is not loaded automatically.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Required for the globe endpoints; /health remains independent.
# Export this in the shell; this file is not loaded automatically.
DATABASE_URL=postgresql://humanflow:CHANGE_ME@127.0.0.1:5432/humanflow
